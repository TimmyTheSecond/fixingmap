{
	"name": "dovedale-map",
	"scripts": {
		"dev:server": "bun run --cwd backend dev",
		"dev:frontend": "bun run --cwd frontend dev",
		"dev": "concurrently --names backend,frontend  \"bun run dev:server\" \"bun run dev:frontend\"",
		"build": "bun run --cwd frontend build",
		"start": "bun run --cwd backend start",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix"
	},
	"workspaces": [
		"frontend",
		"backend"
	],
	"devDependencies": {
		"concurrently": "^10.0.6"
	}
}
