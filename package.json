{
	"name": "dovedale-map",
	"scripts": {
		"dev:server": "bun --watch server.ts",
		"dev:frontend": "bun run --cwd frontend dev",
		"dev": "concurrently --names backend,frontend  \"bun run dev:server\" \"bun run dev:frontend\"",
		"build": "bun run --cwd frontend build",
		"start": "bun server.ts",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix"
	},
	"dependencies": {
		"@hono/bun": "^1.0.1",
		"hono": "^4.13.13",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@types/bun": "1.3.5",
		"concurrently": "^10.0.6",
		"oxfmt": "^0.73.0",
		"oxlint": "^1.88.0"
	},
	"packageManager": "bun@1.3.5"
}
